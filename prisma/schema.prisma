// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  
}


model Administrador {
  id        String   @id @default(uuid())
  email     String   @unique
  senha     String   @map("senha")
  createdAt DateTime @default(now())

  @@map("administradores")
}

model Usuario {
  id               String   @id @default(uuid())
  nome             String
  sobrenome        String
  nomeUsuarioFilho String
  email            String   @unique
  senha            String   @map("senha")
  telefone         String   @unique
  endereco         String   
  idSessao         Sessao[]
  createdAt        DateTime @default(now())

  @@unique([id,nomeUsuarioFilho])
  @@map("usuarios")
}

model Sessao {
  Id               String  @id @default(uuid())
  idUsuario        String
  nomeUsuarioFilho String
  dataSessao       DateTime
  sessaoCombo      Boolean
  status           Boolean
  usuarioFilho     Usuario @relation(fields: [nomeUsuarioFilho, idUsuario], references: [nomeUsuarioFilho,id])

  @@map("Sesssoes")
}